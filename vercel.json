{
    "rewrites": [
      { "source": "/assets/:path*", "destination": "/assets/:path*" },
      { "source": "/(.*)", "destination": "/" }
    ],
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
          "buildCommand": "npm run build",
          "outputDirectory": "dist"
        }
      }
    ]
  }
  